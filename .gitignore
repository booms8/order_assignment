gitignore
# ==============================================================================
# PYTHON EXCLUSIONS
# ==============================================================================
# Byte-compiled / optimized / DLL files
backend/__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging artifacts
.Python
backend/build/
backend/develop-eggs/
backend/dist/
backend/downloads/
backend/eggs/
backend/.eggs/
backend/lib/
backend/lib64/
backend/parts/
backend/sdist/
backend/var/
backend/wheels/
backend/share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.env
.venv
backend/env/
backend/venv/
backend/ENV/
backend/env.bak/
backend/venv.bak/

# Testing and coverage tools
.cache
backend/.pytest_cache/
backend/.tox/
.coverage
.coverage.*
nosetests.xml
coverage.xml
backend/htmlcov/
backend/.mypy_cache/
.dmypy.json
dmypy.json

backend/backend.db

# ==============================================================================
# ANGULAR / NODE EXCLUSIONS
# ==============================================================================
# Dependency directories
frontend/node_modules/

# Angular build outputs
frontend/dist/
frontend/out-tsc/
frontend/tmp/

# Angular cache directory
frontend/.angular/

# Testing reports
frontend/coverage/
frontend/e2e/test-output/

# Log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# TypeScript build cache
*.tsbuildinfo

# Optional: IDE configuration files (uncomment if you want to ignore them)
# .vscode/
# .idea/

# ==============================================================================
# SYSTEM & ENVIRONMENT CONFIGURATIONS
# ==============================================================================
.DS_Store
Thumbs.db
.env.local
.env.*.local
